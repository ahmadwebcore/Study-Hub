# ==============================================================================
# StudyHub — Environment Configuration
# ==============================================================================
# Obtain these credentials from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon public key)
#
# DO NOT commit your real .env file with secrets to public version control.
# NEVER expose the service_role key in frontend client applications.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
